# LLM Provider Configuration
# Set to 'gemini' or 'groq'
LLM_PROVIDER=gemini
# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Speech-to-text provider: 'groq' or 'assemblyai'
SPEECH_PROVIDER=groq
# AssemblyAI API key for speech-to-text (https://www.assemblyai.com/)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Voice messages use GROQ_API_KEY with whisper-large-v3-turbo.
# Select and test the microphone in Settings.
